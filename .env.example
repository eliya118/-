# Local values. Copy to .env. Do not put real secrets in git.
# An empty LLM key with LLM_PROVIDER=openai makes intake preview return 503.
# LLM_PROVIDER=fake answers a few fixed phrases and ideas stays on the seed catalog.

CALENDAR_DATABASE_URL=postgresql+asyncpg://calendar_app:calendar@postgres:5432/calendar
IDEAS_DATABASE_URL=postgresql+asyncpg://ideas_app:ideas@postgres:5432/ideas
NOTIFIER_DATABASE_URL=postgresql+asyncpg://notifier_app:notifier@postgres:5432/notifier
REDIS_URL=redis://redis:6379
INTERNAL_API_TOKEN=local-internal-token-change-me
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=fake
PARENT_EMAIL=parent@example.com
PARENT_PASSWORD=local-parent-password
RESEND_API_KEY=
EMAIL_FROM=calendar@localhost
SMTP_URL=smtp://mailpit:1025
EMAIL_MODE=mailpit
NOTIFIER_CHANNELS=email
APP_TIMEZONE=Asia/Jerusalem
WEB_ORIGIN=http://localhost:5173
INTAKE_URL=http://intake:8000
IDEAS_URL=http://ideas:8000
LOG_LEVEL=INFO
